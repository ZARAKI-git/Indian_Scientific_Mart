# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://qcksvwradejlzhnulvdp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — used to write quote requests and by the ingestion loader. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Quote delivery (QuoteNotifier). "email" (Resend) or "log" (no delivery; dev).
QUOTE_NOTIFIER=log
RESEND_API_KEY=
QUOTE_NOTIFY_TO=
QUOTE_NOTIFY_FROM="Indian Scientific Mart <quotes@example.com>"

# Public site URL, used for canonical URLs, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep search engines out until the client signs off
NEXT_PUBLIC_SITE_LIVE=false

# Ingestion: folder holding the supplier price lists
ISM_SOURCE_DIR=~/Downloads/INDIAN_SCIENTIFIC_MART

# Shared secret for POST /api/revalidate (the loader calls it after a load)
REVALIDATE_SECRET=
